---
import { Trophy } from 'lucide-react';
import '../index.css';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description = "Understand Houston — The definitive mobile-first web directory, logistics portal, and business network for the FIFA World Cup 2026 in Houston.",
  ogType = "website",
  ogImage = "https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&q=80&w=1200&h=630"
} = Astro.props;

// Hardcoded fallback for app link routing
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title} | Understand Houston 2026</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (Facebook / LinkedIn) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Understand Houston 2026`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Understand Houston" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} | Understand Houston 2026`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Web Fonts Preload & Style -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />

    <style is:global>
      /* Apply typography overrides to all components */
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background-color: #FAF8F5; /* Warm Cream */
        color: #1A1A1A; /* Dark Neutral */
      }
      
      /* Heading specifications */
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        letter-spacing: -0.025em;
      }

      /* Custom scrollbars for elegant design integration */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #FAF8F5;
      }
      ::-webkit-scrollbar-thumb {
        background: #F0EAE1;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #A6804E;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <!-- Top Global Announcement Banner (Understandspace Linkage) -->
    <div class="bg-[#8B5C1A] text-[#FAF8F5] text-xs font-semibold py-2 px-4 text-center tracking-wide uppercase border-b border-[#F0EAE1]/20">
      Understand Houston &bull; An Understandspace Intelligence Node &bull; FIFA World Cup 2026 Satellite Portal
    </div>

    <!-- Header navigation -->
    <header class="h-20 px-4 sm:px-10 flex items-center justify-between bg-white border-b border-[#F0EAE1] sticky top-0 z-30">
      <div class="flex flex-col">
        <a href="/" class="flex flex-col group">
          <div class="flex items-center gap-3">
            <span class="text-[18px] font-black tracking-tighter uppercase text-[#1A1A1A] group-hover:text-[#8B5C1A] transition-colors">Understand Houston</span>
            <div class="w-[1px] h-4 bg-[#F0EAE1]"></div>
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#8B5C1A]">Intelligence Node</span>
          </div>
          <p class="text-[9px] uppercase tracking-widest font-bold opacity-40 mt-0.5">Ecosystem Module: Understandspace Core</p>
        </a>
      </div>

      <!-- Quick Info Navigation -->
      <nav class="flex gap-4 sm:gap-8 text-[11px] font-bold uppercase tracking-widest">
        <a href="#directory" class="text-[#8B5C1A] hover:text-[#A6804E] transition-colors border-b-2 border-[#8B5C1A] pb-1">Directory</a>
        <a href="#logistics" class="opacity-50 hover:opacity-100 transition-opacity text-[#1A1A1A]">Logistics</a>
        <a href="#partner" class="opacity-50 hover:opacity-100 transition-opacity text-[#1A1A1A]">Buy Ad Slot</a>
      </nav>
    </header>

    <!-- Main Content Stage -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer with Clear Enterprise Affiliate Branding -->
    <footer class="bg-[#1A1A1A] text-[#FAF8F5]/90 pt-16 pb-8 px-4 sm:px-6 border-t border-[#F0EAE1]">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-12">
          <!-- Main col -->
          <div class="md:col-span-5 space-y-4">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono px-2 py-1 bg-[#8B5C1A]/20 text-[#A6804E] rounded border border-[#8B5C1A]/40 uppercase tracking-widest">Houston 2026 Portal</span>
            </div>
            <h2 class="text-2xl font-black text-white tracking-tight">UNDERSTAND HOUSTON</h2>
            <p class="text-sm text-[#FAF8F5]/70 leading-relaxed max-w-sm">
              The premium regional lead and business accelerator node of Understandspace, serving local hospitality, transport, and commercial champions during the 2026 FIFA World Cup.
            </p>
          </div>

          <!-- Quick Navigation links -->
          <div class="md:col-span-3 space-y-4">
            <h3 class="text-xs font-extrabold tracking-widest text-[#A6804E] uppercase">Resource Nodes</h3>
            <ul class="space-y-2 text-sm text-[#FAF8F5]/60 font-medium">
              <li><a href="#directory" class="hover:text-[#FAF8F5] transition-colors">&rarr; Match City Directory</a></li>
              <li><a href="#logistics" class="hover:text-[#FAF8F5] transition-colors">&rarr; Venue Navigation (NRG)</a></li>
              <li><a href="#partner" class="hover:text-[#FAF8F5] transition-colors">&rarr; Brand Acquisition Form</a></li>
            </ul>
          </div>

          <!-- Ecosystem affiliate attribution block -->
          <div class="md:col-span-4 space-y-4 border-l border-white/10 md:pl-8">
            <h3 class="text-xs font-extrabold tracking-widest text-[#A6804E] uppercase">Ecosystem Integration</h3>
            <p class="text-xs text-[#FAF8F5]/50 leading-relaxed">
              Understand Houston is a tactical deployment of <a href="https://example.com/understandspace" class="underline text-[#A6804E] hover:text-[#FAF8F5]">Understandspace</a>. All data captured on this interface aligns with our global REST schema, powering interactive micro-sites, CRM automation, and local trade connectivity.
            </p>
            <div class="pt-2 text-[10px] font-mono text-[#FAF8F5]/40">
              NODE ID: US-HOU-2026-STLT
            </div>
          </div>
        </div>

        <!-- Copyright / Sub-bottom -->
        <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#FAF8F5]/40 font-medium">
          <p>&copy; 2026 Understand Houston &bull; Powered by Understandspace Intelligence. All rights reserved.</p>
          <div class="flex items-center gap-4">
            <a href="#" class="hover:underline">Privacy Charter</a>
            <span>&bull;</span>
            <a href="#" class="hover:underline">Merchant Terms</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
