---
import Layout from '../layouts/Layout.astro';
import MuiWrapper from '../components/MuiWrapper';
import PartnerForm from '../components/PartnerForm';
import { 
  Compass, 
  MapPin, 
  Calendar, 
  Car, 
  Clock, 
  ChevronRight, 
  ShieldCheck, 
  Trophy, 
  Sparkles,
  UtensilsCrossed,
  ArrowRight
} from 'lucide-react';

// Static local premium directories (Zero-JS on client for extreme performance)
const directories = [
  {
    category: "Gastronomy & Lounges",
    sub: "Elite Texan culinary spots",
    items: [
      {
        name: "The Pit Ranch BBQ",
        description: "Legendary handcrafted hickory-smoked brisket and custom catering packages located 1.2 miles from NRG Stadium.",
        accent: "Midtown",
        logoColor: "text-amber-800 bg-amber-50",
        tag: "Verified Member"
      },
      {
        name: "Gala Soccer Biergarten",
        description: "The ultimate pop-up outdoor screen garden. Craft beers, live DJs, and massive projection screens.",
        accent: "Downtown",
        logoColor: "text-amber-800 bg-amber-50",
        tag: "World Cup Partner"
      }
    ]
  },
  {
    category: "Transport & Logistics",
    sub: "Direct airport & stadium transfers",
    items: [
      {
        name: "Space City Logistics Shuttles",
        description: "Scheduled luxury coach services delivering hassle-free connections from IAH & Hobby directly to NRG Stadium lanes.",
        accent: "County-wide",
        logoColor: "text-amber-800 bg-amber-50",
        tag: "Official Transit Node"
      },
      {
        name: "Houston Grid-Rail Access",
        description: "Official guide to Houston MetroRail. Direct high-speed red-line routes straight to the stadium gate.",
        accent: "Rail System",
        logoColor: "text-amber-800 bg-amber-50",
        tag: "Municipal Guide"
      }
    ]
  },
  {
    category: "Executive Services",
    sub: "Understandspace merchant hub",
    items: [
      {
        name: "Champions Executive Suites",
        description: "Corporate workspace, secure high-speed Wi-Fi, and private conference suites for international sports agencies.",
        accent: "Galleria",
        logoColor: "text-amber-800 bg-amber-50",
        tag: "Understandspace Node"
      },
      {
        name: "Prime Shield Escorts & Valet",
        description: "Secure diplomat-tier transport, private parking reservations, and VIP chauffeur solutions for team delegations.",
        accent: "VIP Services",
        logoColor: "text-amber-800 bg-amber-50",
        tag: "Premium Ad Tier"
      }
    ]
  }
];

// Matches taking place at Houston NRG Stadium (World Cup 2026)
const matchSchedule = [
  { date: "June 14, 2026", type: "Group Stage", match: "Team A vs. Team B", time: "17:00 CST" },
  { date: "June 17, 2026", type: "Group Stage", match: "Team C vs. Team D", time: "20:00 CST" },
  { date: "June 22, 2026", type: "Group Stage", match: "Team E vs. Team F", time: "18:00 CST" },
  { date: "June 26, 2026", type: "Group Stage", match: "Team G vs. Team H", time: "14:00 CST" },
  { date: "June 29, 2026", type: "Round of 32", match: "Winner Group H vs. Runner-up Group I", time: "19:30 CST" },
  { date: "July 04, 2026", type: "Quarter-Final", match: "TBD vs. TBD", time: "16:00 CST" }
];
---

<Layout title="The 2026 World Cup Houston Directory">
  
  <!-- Hero Section -->
  <section class="relative bg-[#FAF8F5] pt-12 pb-20 px-4 sm:px-6 border-b border-[#F0EAE1] overflow-hidden">
    <!-- Abstract subtle ambient design (pure CSS, no images needed) -->
    <div class="absolute inset-0 bg-[radial-gradient(#8B5C1A_0.6px,transparent_0.6px)] [background-size:16px_16px] opacity-[0.25]"></div>
    
    <div class="relative max-w-5xl mx-auto text-center space-y-6 pt-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#8B5C1A]/10 text-[#8B5C1A] text-[10px] font-bold tracking-widest uppercase rounded-full border border-[#8B5C1A]/20">
        <Sparkles class="w-3 h-3 animate-pulse" />
        World Cup 2026 regional launchpad
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-[#1A1A1A] tracking-tight leading-[1.1] max-w-4xl mx-auto">
        Understand Houston. <br/>
        <span class="text-[#8B5C1A]">Host City Intel Node.</span>
      </h1>
      
      <p class="text-base sm:text-lg text-[#1A1A1A]/75 font-medium max-w-2xl mx-auto leading-relaxed">
        Your high-performance, mobile-first Web Directory for the 2026 World Cup in Houston. Discover premier merchant spaces, optimize transport logistics, and secure tactical promotion slots in our global network.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#directory" class="w-full sm:w-auto px-6 py-3.5 bg-[#8B5C1A] text-white font-bold rounded-[12px] hover:bg-[#A6804E] transition-all flex items-center justify-center gap-2">
          <span>Explore Stadium Directory</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a href="#partner" class="w-full sm:w-auto px-6 py-3.5 bg-white border border-[#F0EAE1] text-[#1A1A1A] font-bold rounded-[12px] hover:bg-[#FAF8F5] transition-all flex items-center justify-center gap-2">
          <span>Acquire Directory Ad Slot</span>
          <span class="text-[#A6804E] font-medium">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Grid Stats/Overview -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 -mt-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white border border-[#F0EAE1] p-6 rounded-[12px] shadow-sm flex items-start gap-4">
        <div class="p-3 bg-[#FAF8F5] rounded-[8px] text-[#8B5C1A]">
          <MapPin class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#A6804E] mb-1">NRG Stadium Central</h3>
          <p class="text-2xl font-black text-[#1A1A1A]">72,220+</p>
          <p class="text-xs text-[#1A1A1A]/60 mt-0.5">Capacity World Cup Match Venue</p>
        </div>
      </div>

      <div class="bg-white border border-[#F0EAE1] p-6 rounded-[12px] shadow-sm flex items-start gap-4">
        <div class="p-3 bg-[#FAF8F5] rounded-[8px] text-[#8B5C1A]">
          <Trophy class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#A6804E] mb-1">Total Venue Games</h3>
          <p class="text-2xl font-black text-[#1A1A1A]">6 Key Matches</p>
          <p class="text-xs text-[#1A1A1A]/60 mt-0.5">Including Round of 32 & Quarter-final</p>
        </div>
      </div>

      <div class="bg-white border border-[#F0EAE1] p-6 rounded-[12px] shadow-sm flex items-start gap-4">
        <div class="p-3 bg-[#FAF8F5] rounded-[8px] text-[#8B5C1A]">
          <ShieldCheck class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#A6804E] mb-1">Merchant Integration</h3>
          <p class="text-2xl font-black text-[#1A1A1A]">100% Real API</p>
          <p class="text-xs text-[#1A1A1A]/60 mt-0.5">Direct pipelines to Understandspace API</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Vetted Local Business & Resource Directories -->
  <section id="directory" class="max-w-7xl mx-auto px-4 sm:px-6 py-20 space-y-12">
    <div class="text-center max-w-2xl mx-auto">
      <span class="text-xs font-extrabold tracking-widest text-[#8B5C1A] uppercase block mb-2">Curated Hospitality Hub</span>
      <h2 class="text-3xl sm:text-4xl font-black text-[#1A1A1A] tracking-tight">The World Cup Houston Node</h2>
      <p class="text-sm text-[#1A1A1A]/65 mt-2">
        Browse certified transport guidelines, fine dining hotspots, and high-frequency hospitality outlets verified by our editorial network.
      </p>
    </div>

    <!-- Category Bento Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {directories.map((dir) => (
        <div class="bg-white border border-[#F0EAE1] rounded-[12px] p-6 flex flex-col justify-between hover:shadow-md transition-all">
          <div>
            <div class="border-b border-[#F0EAE1] pb-4 mb-4">
              <span class="text-[10px] font-extrabold uppercase tracking-widest text-[#8B5C1A]">{dir.sub}</span>
              <h3 class="text-xl font-bold text-[#1A1A1A] mt-1">{dir.category}</h3>
            </div>
            
            <div class="space-y-6">
              {dir.items.map((item) => (
                <div class="group border-b border-[#F0EAE1]/40 last:border-0 pb-4 last:pb-0">
                  <div class="flex items-center justify-between gap-2 mb-1.5">
                    <h4 class="font-bold text-sm text-[#1A1A1A] group-hover:text-[#8B5C1A] transition-colors">{item.name}</h4>
                    <span class="text-[9px] font-bold px-2 py-0.5 bg-[#FAF8F5] text-[#A6804E] rounded-full border border-[#F0EAE1]">
                      {item.tag}
                    </span>
                  </div>
                  <p class="text-xs text-[#1A1A1A]/70 leading-relaxed mb-2">{item.description}</p>
                  <span class="text-[10px] font-semibold text-[#A6804E] tracking-tight uppercase flex items-center gap-1">
                    <MapPin class="w-3 h-3" /> {item.accent}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-6 border-t border-[#F0EAE1] mt-6">
            <a href="#partner" class="w-full text-center text-xs font-bold text-[#8B5C1A] uppercase tracking-wide flex items-center justify-center gap-1 group-hover:underline">
              <span>Secure custom ad placement here</span>
              <ChevronRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section: Stadium Spotlight & Logistics -->
  <section id="logistics" class="bg-[#FAF8F5] py-20 border-t border-b border-[#F0EAE1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Text/Intel Column -->
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#8B5C1A]/10 text-[#8B5C1A] text-[10px] font-bold tracking-widest uppercase rounded-full border border-[#8B5C1A]/20">
            Venue Spotlight: NRG Stadium
          </div>
          
          <h2 class="text-3xl sm:text-4xl font-black text-[#1A1A1A] tracking-tight leading-tight">
            Seamless Logistics for the Global Stage
          </h2>
          
          <p class="text-sm text-[#1A1A1A]/70 leading-relaxed">
            NRG Stadium matches represent some of the highest-traffic events of the 2026 World Cup. Under standard municipal routing guidelines, we recommend utilize of public light rails and designated Understandspace transit nodes to evade extreme parking delays.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-3">
              <div class="p-1.5 bg-[#8B5C1A]/10 text-[#8B5C1A] rounded mt-0.5">
                <Car class="w-4 h-4" />
              </div>
              <div>
                <h4 class="font-bold text-sm text-[#1A1A1A]">Dedicated Park & Ride Solutions</h4>
                <p class="text-xs text-[#1A1A1A]/65">Access direct non-stop shuttles from Midtown and Galleria parking grids.</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="p-1.5 bg-[#8B5C1A]/10 text-[#8B5C1A] rounded mt-0.5">
                <Clock class="w-4 h-4" />
              </div>
              <div>
                <h4 class="font-bold text-sm text-[#1A1A1A]">Stadium Access Optimization</h4>
                <p class="text-xs text-[#1A1A1A]/65">Gates open 3.5 hours prior to kickoff. Ensure you verify ticket QR passes on the official FIFA app beforehand.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Dynamic Game Calendar/Schedule Column -->
        <div class="lg:col-span-6">
          <div class="bg-white border border-[#F0EAE1] rounded-[12px] p-6 shadow-sm">
            <div class="flex items-center justify-between border-b border-[#F0EAE1] pb-4 mb-4">
              <div>
                <h3 class="text-base font-bold text-[#1A1A1A]">Houston Match Calendar</h3>
                <p class="text-xs text-[#A6804E] font-medium">Official Match Schedule at NRG Stadium</p>
              </div>
              <Trophy class="w-6 h-6 text-[#8B5C1A]" />
            </div>

            <div class="divide-y divide-[#F0EAE1]/50 h-[300px] overflow-y-auto pr-2">
              {matchSchedule.map((match) => (
                <div class="py-3 flex items-center justify-between text-xs">
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="font-bold text-[#1A1A1A]">{match.date}</span>&bull;
                      <span class="text-[#8B5C1A] font-semibold">{match.type}</span>
                    </div>
                    <div class="text-[#1A1A1A]/70 mt-1 font-medium text-sm">{match.match}</div>
                  </div>
                  <div class="text-right font-mono text-[#FAF8F5] bg-[#A6804E] px-2 py-1 rounded font-semibold text-[10px]">
                    {match.time}
                  </div>
                </div>
              ))}
            </div>
            
            <div class="text-center mt-4 pt-3 border-t border-[#F0EAE1]">
              <p class="text-[10px] font-bold tracking-wider text-[#A6804E]/80 uppercase">
                Times listed in Central Standard Time (CST)
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section: Ad Slot Acquisition Form -->
  <section id="partner" class="max-w-4xl mx-auto px-4 sm:px-6 py-20 space-y-10">
    <div class="text-center space-y-3">
      <span class="text-xs font-extrabold tracking-widest text-[#8B5C1A] uppercase block">Acquisition Gate</span>
      <h2 class="text-3xl sm:text-4xl font-black text-[#1A1A1A] tracking-tight">Expand Your Enterprise Presence</h2>
      <p class="text-sm text-[#1A1A1A]/65 max-w-xl mx-auto">
        Join the directory network. Use our secure Material UI intake below to reserve premium slots. Leads sync in real-time with the central Understandspace node.
      </p>
    </div>

    <!-- Mount React Component Island wrapper strictly on the client-side to prevent SSR style mismatches under React 19 -->
    <MuiWrapper client:only="react">
      <PartnerForm client:only="react" />
    </MuiWrapper>
  </section>

</Layout>
